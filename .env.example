# SeaSweep env names are the current default. Legacy OCEANROUTE_* names still work as fallbacks.
SEASWEEP_APP_NAME=SeaSweep API
SEASWEEP_API_PREFIX=/api
SEASWEEP_PILOT_REGION=sf_bay_estuary
SEASWEEP_DATABASE_URL=postgresql+psycopg://seasweep:seasweep@localhost:5432/seasweep
SEASWEEP_FORECAST_HOURS=24
SEASWEEP_INGEST_MODE=auto
SEASWEEP_SCHEDULER_ENABLED=false
SEASWEEP_SCHEDULER_INTERVAL_MINUTES=60
SEASWEEP_LIVE_TIMEOUT_SECONDS=6
SEASWEEP_FORECAST_STALE_AFTER_MINUTES=180
SEASWEEP_DEFAULT_DEPOT_LAT=37.8066
SEASWEEP_DEFAULT_DEPOT_LON=-122.4659
SEASWEEP_VESSEL_SPEED_KMH=18.0
SEASWEEP_WRITE_DEBUG_ARTIFACTS=true
SEASWEEP_CORS_ALLOWED_ORIGINS=*
SEASWEEP_POSTGRES_DB=seasweep
SEASWEEP_POSTGRES_USER=seasweep
SEASWEEP_POSTGRES_PASSWORD=seasweep
VITE_API_BASE=/api
