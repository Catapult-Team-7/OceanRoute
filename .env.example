OCEANROUTE_APP_NAME=SeaSweep API
OCEANROUTE_API_PREFIX=/api
OCEANROUTE_PILOT_REGION=sf_bay_estuary
OCEANROUTE_DATABASE_URL=postgresql+psycopg://oceanroute:oceanroute@localhost:5432/oceanroute
OCEANROUTE_FORECAST_HOURS=24
OCEANROUTE_INGEST_MODE=auto
OCEANROUTE_SCHEDULER_ENABLED=false
OCEANROUTE_SCHEDULER_INTERVAL_MINUTES=60
OCEANROUTE_LIVE_TIMEOUT_SECONDS=6
OCEANROUTE_FORECAST_STALE_AFTER_MINUTES=180
OCEANROUTE_DEFAULT_DEPOT_LAT=37.8066
OCEANROUTE_DEFAULT_DEPOT_LON=-122.4659
OCEANROUTE_VESSEL_SPEED_KMH=18.0
OCEANROUTE_WRITE_DEBUG_ARTIFACTS=true
OCEANROUTE_CORS_ALLOWED_ORIGINS=*
VITE_API_BASE=/api
